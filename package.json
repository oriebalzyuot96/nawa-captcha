{
  "name": "nawa-guard-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Nawa Guard: privacy-friendly, accessible puzzle CAPTCHA (30+ puzzle types) with server-sealed solutions.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/server",
    "packages/widget",
    "packages/react",
    "packages/vue",
    "packages/svelte",
    "packages/angular",
    "demo"
  ],
  "scripts": {
    "build": "npm run build -w @nawa-guard/server -w @nawa-guard/widget -w @nawa-guard/react -w @nawa-guard/vue -w @nawa-guard/angular",
    "typecheck": "npm run build -w @nawa-guard/widget && npm run typecheck --workspaces --if-present && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:dotnet": "dotnet test dotnet/NawaGuard.sln",
    "demo": "npm run build -w @nawa-guard/server -w @nawa-guard/widget && node demo/server.mjs",
    "fixture:dotnet": "npm run build -w @nawa-guard/server && node scripts/make-dotnet-fixture.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
