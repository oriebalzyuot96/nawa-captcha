<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>NawaGuard.AspNetCore</RootNamespace>
    <PackageId>NawaGuard.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Description>Server-side verification of Nawa Guard pass tokens for ASP.NET Core: INawaGuardVerifier, [RequireNawaGuard] and minimal-API endpoint filters.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>captcha;bot-protection;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
