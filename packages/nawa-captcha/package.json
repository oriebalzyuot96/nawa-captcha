{
  "name": "nawa-captcha",
  "version": "0.1.1",
  "description": "Nawa Captcha in one package: a self-hosted, accessible puzzle CAPTCHA with 38 challenge types, an audio challenge and themes. Server (Node.js/Express) plus the <nawa-captcha> widget and React, Vue, Svelte and Angular components. An open-source reCAPTCHA / hCaptcha / Turnstile alternative.",
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./express": {
      "types": "./dist/server/express.d.ts",
      "import": "./dist/server/express.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./angular": {
      "types": "./dist/angular/types/nawa-captcha-angular.d.ts",
      "default": "./dist/angular/fesm2022/nawa-captcha-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "./dist/server/primitives.js": "./dist/server/primitives.browser.js"
  },
  "sideEffects": [
    "./dist/widget/**",
    "./dist/react/**",
    "./dist/vue/**",
    "./dist/svelte/**",
    "./dist/angular/**"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-umbrella.mjs",
    "prepublishOnly": "node ../../scripts/build-umbrella.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": ">=18.0.0",
    "@angular/forms": ">=18.0.0",
    "react": ">=18",
    "svelte": "^5.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": { "optional": true },
    "@angular/forms": { "optional": true },
    "react": { "optional": true },
    "svelte": { "optional": true },
    "vue": { "optional": true }
  },
  "keywords": [
    "nawa-captcha",
    "captcha",
    "recaptcha-alternative",
    "hcaptcha-alternative",
    "turnstile-alternative",
    "self-hosted-captcha",
    "accessible-captcha",
    "audio-captcha",
    "puzzle-captcha",
    "slider-captcha",
    "bot-protection",
    "anti-spam",
    "proof-of-work",
    "privacy",
    "gdpr",
    "react",
    "vue",
    "svelte",
    "angular",
    "web-component",
    "express",
    "nodejs",
    "arabic",
    "rtl"
  ],
  "homepage": "https://oriebalzyuot96.github.io/nawa-captcha/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/nawa-captcha.git",
    "directory": "packages/nawa-captcha"
  },
  "bugs": "https://github.com/oriebalzyuot96/nawa-captcha/issues",
  "author": "oriebalzyuot96",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
