{
  "name": "@nawa-guard/server",
  "version": "0.1.0",
  "description": "Nawa Guard server: self-hosted, privacy-friendly puzzle CAPTCHA for Node.js. 8 challenge types, sealed answers, single-use pass tokens, Express middleware. A reCAPTCHA / hCaptcha alternative with no third-party tracking.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "nodejs",
    "express",
    "middleware",
    "server",
    "verification",
    "captcha",
    "recaptcha-alternative",
    "hcaptcha-alternative",
    "turnstile-alternative",
    "self-hosted-captcha",
    "accessible-captcha",
    "puzzle-captcha",
    "slider-captcha",
    "privacy",
    "gdpr",
    "bot-protection",
    "anti-spam",
    "proof-of-work",
    "nawa-guard",
    "nawa-ui",
    "arabic",
    "rtl",
    "accessibility"
  ],
  "homepage": "https://oriebalzyuot96.github.io/nawa-guard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/nawa-guard.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/oriebalzyuot96/nawa-guard/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
  }
}
