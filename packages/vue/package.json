{
  "name": "@nawa-captcha/vue",
  "version": "0.1.0",
  "description": "Nawa Captcha for Vue 3: accessible, self-hosted puzzle CAPTCHA component with v-model — a privacy-friendly reCAPTCHA alternative.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nawa-captcha/widget": "0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "captcha",
    "recaptcha-alternative",
    "hcaptcha-alternative",
    "turnstile-alternative",
    "self-hosted-captcha",
    "accessible-captcha",
    "puzzle-captcha",
    "slider-captcha",
    "privacy",
    "gdpr",
    "bot-protection",
    "anti-spam",
    "proof-of-work",
    "nawa-captcha",
    "orca-ui",
    "arabic",
    "rtl"
  ],
  "homepage": "https://oriebalzyuot96.github.io/nawa-captcha/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/nawa-captcha.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/oriebalzyuot96/nawa-captcha/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
  }
}
