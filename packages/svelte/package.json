{
  "name": "@nawa-captcha/svelte",
  "version": "0.1.0",
  "description": "Nawa Captcha for Svelte 5: accessible, self-hosted puzzle CAPTCHA component — a privacy-friendly reCAPTCHA alternative.",
  "license": "MIT",
  "type": "module",
  "svelte": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@nawa-captcha/widget": "0.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.40.0",
    "svelte-check": "^4.3.0"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-component",
    "captcha",
    "recaptcha-alternative",
    "hcaptcha-alternative",
    "turnstile-alternative",
    "self-hosted-captcha",
    "accessible-captcha",
    "puzzle-captcha",
    "slider-captcha",
    "privacy",
    "gdpr",
    "bot-protection",
    "anti-spam",
    "proof-of-work",
    "nawa-captcha",
    "orca-ui",
    "arabic",
    "rtl"
  ],
  "homepage": "https://oriebalzyuot96.github.io/nawa-captcha/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/nawa-captcha.git",
    "directory": "packages/svelte"
  },
  "bugs": "https://github.com/oriebalzyuot96/nawa-captcha/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
  }
}
