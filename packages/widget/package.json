{
  "name": "@nawa-captcha/widget",
  "version": "0.1.1",
  "description": "Nawa Captcha widget: accessible <nawa-captcha> web component (keyboard, touch, screen-reader alternative, RTL, themes) for the self-hosted Nawa Captcha CAPTCHA.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "vanilla-js",
    "framework-agnostic",
    "captcha",
    "recaptcha-alternative",
    "hcaptcha-alternative",
    "turnstile-alternative",
    "self-hosted-captcha",
    "accessible-captcha",
    "puzzle-captcha",
    "slider-captcha",
    "privacy",
    "gdpr",
    "bot-protection",
    "anti-spam",
    "proof-of-work",
    "nawa-captcha",
    "pelagic-ui",
    "arabic",
    "rtl",
    "accessibility"
  ],
  "homepage": "https://oriebalzyuot96.github.io/nawa-captcha/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/nawa-captcha.git",
    "directory": "packages/widget"
  },
  "bugs": "https://github.com/oriebalzyuot96/nawa-captcha/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
  }
}
